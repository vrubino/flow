{
  "name": "flow",
  "version": "1.0.0",
  "private": true,
  "description": "Flow — personal dashboard: capture, to-dos, appointments, zones, morning review",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=www/app.js --minify --sourcemap",
